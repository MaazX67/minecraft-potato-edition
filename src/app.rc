#include <windows.h>

101 ICON "potato.ico"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Minecraft Potato Edition - independent C++ voxel game\0"
            VALUE "FileVersion", "1.1.0-Alpha\0"
            VALUE "InternalName", "PotatoEdition\0"
            VALUE "OriginalFilename", "PotatoEdition.exe\0"
            VALUE "ProductName", "Minecraft Potato Edition\0"
            VALUE "ProductVersion", "1.1.0-Alpha\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
